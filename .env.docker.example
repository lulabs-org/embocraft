# Docker 部署环境变量配置示例

# 端口配置
WEB_PORT=80
POSTGRES_PORT=55432

# 数据库配置
POSTGRES_USER=voxel
POSTGRES_PASSWORD=voxelpassword
POSTGRES_DB=voxel

# 跨域设置（默认 * 允许任意 IP 或域名访问）
WEB_ORIGIN=*

# 共享 Speaches：Whisper ASR + Piper TTS
SPEECH_PORT=8000
# SPEECH_API_URL=http://speech:8000/v1
# WHISPER_API_URL=  # ASR 独立覆盖
# PIPER_API_URL=    # TTS 独立覆盖
# 旧 WHISPER_PORT 和网络名 whisper 仍兼容；模型卷不变。

# 模型服务、Agent 行为及语音参数在 Web 控制台配置。
