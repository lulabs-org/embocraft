generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
model World {
 id String @id
 revision Int @default(0)
 edits BlockEdit[]
}
model BlockEdit {
 worldId String
 x Int
 y Int
 z Int
 material String?
 world World @relation(fields:[worldId], references:[id], onDelete: Cascade)
 @@id([worldId,x,y,z])
}

model AgentProvider {
 id String @id
 position Int
 name String
 type String
 baseUrl String
 apiKey String
 defaultModel String
 characters AgentCharacter[]
}

// Distinguishes an intentionally empty provider catalog from a fresh database.
model AgentProviderState {
 id Int @id
}

model AgentCharacter {
 id String @id
 providerId String
 position Int
 // CharacterRecord: durable profile, presence, logs and authoritative current runtime.
 // Derived API fields are rebuilt by the character module, never stored here.
 data Json
 provider AgentProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
}

model AgentPlan {
 id String @id
 position Int
 data Json
}

model AgentRun {
 id String @id
 position Int
 // archive-codec stores identical current runtimes as runtimeRef; history stays inline.
 data Json
}

model AgentRequest {
 key String @id
 planId String
}

model TtsService {
 id String @id
 position Int
 data Json
}

// Preserves an intentionally empty TTS catalog across restarts.
model TtsCatalogState {
 id Int @id
}

model AsrService {
 id String @id
 position Int
 data Json
}
