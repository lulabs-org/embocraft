generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
model World {
 id String @id
 revision Int @default(0)
 edits BlockEdit[]
}
model BlockEdit {
 worldId String
 x Int
 y Int
 z Int
 material String?
 world World @relation(fields:[worldId], references:[id], onDelete: Cascade)
 @@id([worldId,x,y,z])
}

model AgentProvider {
 id String @id
 position Int
 name String
 type String
 baseUrl String
 apiKey String
 defaultModel String
 characters AgentCharacter[]
}


model AgentCharacter {
 id String @id
 providerId String
 position Int
 name String?
 model String?
 goal String?
 roleDescription String?
 taskLimitsEnabled Boolean?
 maxTurns Int?
 maxStalledTurns Int?
 tokenBudget Int?
 taskTimeoutMs Int?
 intervalMode String?
 intervalMinMs Int?
 intervalMaxMs Int?
 intervalMs Int?
 timeoutMs Int?
 maxTokens Int?
 permissions Json?
 skills Json?
 voiceReplies Boolean?
 voiceServiceId String?
 thinking String?
 reasoningEffort String?
 createdAt DateTime? @default(now())
 state AgentCharacterState?
 logs AgentCharacterLog[]
 plans AgentPlan[]
 runs AgentRun[]
 voiceService TtsProvider? @relation(fields: [voiceServiceId], references: [id], onDelete: Restrict)
 provider AgentProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

 @@index([voiceServiceId])
}

// Character memory is independent of the selected Run checkpoint.
model AgentCharacterState {
 characterId String @id
 status String?
 currentRunId String?
 currentCheckpoint AgentRunCheckpoint? @relation(fields: [currentRunId], references: [runId], onDelete: NoAction, onUpdate: NoAction)
 // Persist Runs and checkpoints before selecting the current execution.
 currentRun AgentRun? @relation("CurrentExecution", fields: [currentRunId, characterId], references: [id, characterId], onDelete: NoAction, onUpdate: NoAction)
 runtimeVersion Int?
 memory Json?
 standby Json?
 character AgentCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model AgentCharacterLog {
 characterId String
 sequence Int
 time Float?
 text String
 character AgentCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
 @@id([characterId, sequence])
}

model AgentPlan {
 id String @id
 // Preserve archive ordering until task queries move to database pagination.
 position Int
 characterId String?
 characterName String?
 revision Int?
 imported Boolean?
 name String
 goal String
 scheduleKind String
 scheduleSpec Json
 timeZone String
 limits Json
 limitsMode String?
 totalTokenBudgetEnabled Boolean?
 totalTokenBudget BigInt
 state String
 reason String
 nextRunAt DateTime?
 spentTokens BigInt
 createdAt DateTime
 updatedAt DateTime

 character AgentCharacter? @relation(fields: [characterId], references: [id], onDelete: SetNull)
 runs AgentRun[]
 requests AgentRequest[]

 @@index([state, nextRunAt])
 @@index([characterId, createdAt, id])
}

model AgentRun {
 id String @id
 // Preserve archive ordering until task queries move to database pagination.
 position Int
 planId String?
 planRevision Int?
 characterId String?
 // Historical domain/API attribution survives character deletion.
 characterIdSnapshot String?
 characterName String?
 source String
 status String
 reason String
 scheduledAt DateTime
 startedAt DateTime?
 finishedAt DateTime?
 eventId String?
 coalescedTriggers Int?
 lastTriggerAt DateTime?
 snapshot Json
 task Json?
 totalTokens BigInt
 accountedTokens BigInt
 logs Json
 actions Json?
 requestId String?
 lastBatch String?
 requiresReassignment Boolean?
 checkpoint AgentRunCheckpoint?
 character AgentCharacter? @relation(fields: [characterId], references: [id], onDelete: SetNull)
 plan AgentPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)
 selectedBy AgentCharacterState[] @relation("CurrentExecution")

 @@unique([id, characterId])
 @@unique([planId, requestId])

 @@index([planId, scheduledAt, id])
 @@index([characterId, status])
}

// One execution checkpoint; never contains character conversations, inbox or usage.
model AgentRunCheckpoint {
 runId String @id
 version Int
 execution Json
 selectedBy AgentCharacterState[]
 run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model AgentRequest {
 key String @id
 planId String
 plan AgentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

 @@index([planId])
}

model TtsProvider {
  id            String  @id
  position      Int
  name          String
  type          String
  baseUrl       String  @default("")
  apiKey        String  @default("")
  model         String  @default("")
  voice         String  @default("")
  speed         Float   @default(1.0)
  voiceLanguage String?
  characters AgentCharacter[]
}


model AsrProvider {
  id          String   @id
  position    Int
  name        String
  provider    String   @default("bailian")
  model       String
  apiKey      String   @default("")
  assignments AsrAssignment[]
  region      String?
  workspaceId String?
  baseUrl     String?
  temperature Float?
  prompt      String?
}


enum AsrUse {
  chat
  spatial
  clip
}

model AsrAssignment {
  use AsrUse @id
  providerId String
  provider AsrProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}
