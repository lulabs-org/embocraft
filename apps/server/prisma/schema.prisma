generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
model World {
 id String @id
 revision Int @default(0)
 edits BlockEdit[]
}
model BlockEdit {
 worldId String
 x Int
 y Int
 z Int
 material String?
 world World @relation(fields:[worldId], references:[id], onDelete: Cascade)
 @@id([worldId,x,y,z])
}

model AgentProvider {
 id String @id
 position Int
 name String
 type String
 baseUrl String
 apiKey String
 defaultModel String
 characters AgentCharacter[]
}

// Distinguishes an intentionally empty provider catalog from a fresh database.
model AgentProviderState {
 id Int @id
}

model AgentCharacter {
 id String @id
 providerId String
 position Int
 data Json
 provider AgentProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
}

model AgentPlan {
 id String @id
 position Int
 data Json
}

model AgentRun {
 id String @id
 position Int
 data Json
}

model AgentRequest {
 key String @id
 planId String
}

model TtsProvider {
  id            String  @id
  position      Int
  name          String
  type          String
  baseUrl       String  @default("")
  apiKey        String  @default("")
  model         String  @default("")
  voice         String  @default("")
  speed         Float   @default(1.0)
  voiceLanguage String?
}

// Preserves an intentionally empty TTS catalog across restarts.
model TtsProviderState {
  id Int @id
}

model AsrProvider {
  id          String   @id
  position    Int
  name        String
  provider    String   @default("bailian")
  model       String
  apiKey      String   @default("")
  uses        String[] @default([])
  region      String?
  workspaceId String?
  baseUrl     String?
  temperature Float?
  prompt      String?
}
