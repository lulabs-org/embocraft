{
  "name": "embocraft",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.6.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm --filter @voxel/server dev\" \"pnpm --filter @voxel/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @voxel/server exec prisma generate",
    "db:migrate": "pnpm --filter @voxel/server exec prisma migrate dev",
    "db:deploy": "pnpm --filter @voxel/server exec prisma migrate deploy",
    "db:seed": "pnpm --filter @voxel/server exec prisma db seed",
    "db:studio": "pnpm --filter @voxel/server exec prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "@types/ws": "8.18.2",
    "@voxel/agent-runtime": "workspace:*",
    "@voxel/shared": "workspace:*",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.4",
    "ws": "8.22.0"
  }
}
