{
  "name": "embocraft",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.6.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm --filter @voxel/server dev\" \"pnpm --filter @voxel/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "node scripts/database.mjs",
    "db:stop": "node scripts/database.mjs stop",
    "db:generate": "pnpm --filter @voxel/server exec prisma generate",
    "db:migrate": "pnpm --filter @voxel/server exec dotenv -e ../../.env -- prisma migrate deploy",
    "agent": "tsx scripts/agent/ai-agent.ts",
    "agent:ai": "tsx scripts/agent/ai-agent.ts",
    "agent:mock": "tsx scripts/agent/scripted-agent.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:integration": "pnpm --filter @voxel/server exec tsx test/integration/world-client.ts",
    "format": "prettier --write apps packages scripts tests README.md README_CN.md docs eslint.config.js package.json tsconfig.json pnpm-workspace.yaml",
    "format:check": "prettier --check apps packages scripts tests README.md README_CN.md docs eslint.config.js package.json tsconfig.json pnpm-workspace.yaml",
    "docs:dev": "pnpm --filter @voxel/docs dev",
    "docs:build": "pnpm --filter @voxel/docs build",
    "docs:preview": "pnpm --filter @voxel/docs preview",
    "test:agent:deepseek": "pnpm --filter @voxel/server test:agent:deepseek",
    "test:agents": "pnpm --filter @voxel/server exec tsx test/integration/agent-management.ts",
    "test:chat": "pnpm --filter @voxel/server exec tsx test/integration/chat.ts",
    "test:player:names": "pnpm --filter @voxel/server exec tsx test/integration/player-names.ts",
    "test:agent:voice": "pnpm --filter @voxel/server exec tsx test/integration/agent-speech.ts",
    "test:voice:live": "pnpm --filter @voxel/server exec tsx test/integration/live-speech.ts",
    "test:voice:services": "pnpm --filter @voxel/server exec tsx test/integration/voice-services.ts",
    "test:agent:tasks": "pnpm --filter @voxel/server exec tsx test/integration/agent-tasks.ts",
    "test:navigation": "pnpm --filter @voxel/server exec tsx test/integration/navigation.ts",
    "bench:navigation": "tsx tests/benchmarks/navigation.ts",
    "test:navigation:live": "pnpm --filter @voxel/server exec tsx test/integration/navigation-live-model.ts",
    "agent:ctl": "tsx scripts/agent/agent-control.ts",
    "test:gateway": "pnpm --filter @voxel/server exec tsx test/integration/gateway.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "@types/ws": "8.18.2",
    "@voxel/agent-runtime": "workspace:*",
    "@voxel/shared": "workspace:*",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.4",
    "ws": "8.22.0"
  }
}
