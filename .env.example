# 本地开发与 Docker Compose 共用的部署配置示例。
# 首次使用时复制为 .env；已有 .env 按需补充。注释项表示可选覆盖。
# 模型服务、托管 Agent、TTS 和 ASR 参数在 Web 控制台配置。
# 独立 AI 玩家使用命令行参数，详见 docs/agent/players.md。

# 1. 通用配置

# 前端来源：本地默认 http://127.0.0.1:5173，Docker 默认 *。
# 使用域名部署时填写完整来源，例如 https://world.example.com。
# WEB_ORIGIN=http://127.0.0.1:5173

# 语音服务：本地默认 http://127.0.0.1:8000/v1，Docker 默认 http://speech:8000/v1。
# 覆盖地址应能从服务端所在环境访问；单独配置 ASR 或 TTS 时使用对应覆盖项。
# SPEECH_API_URL=
# WHISPER_API_URL=
# PIPER_API_URL=

# 管理网关令牌：未设置时在服务端 .data/agent-gateway-token 自动生成。
# AGENT_GATEWAY_TOKEN=
# 管理界面允许的来源，多个来源用逗号分隔，非默认端口需一并填写。
# 本地默认跟随 WEB_ORIGIN；Docker 默认 http://localhost,http://127.0.0.1。
# AGENT_GATEWAY_ALLOWED_ORIGINS=https://world.example.com

# 2. 本地开发

# 数据库：先运行 pnpm db:start，再运行 pnpm db:migrate。
# 该连接串对应本地脚本的默认数据库；Docker 使用下方 POSTGRES_* 配置生成连接串。
DATABASE_URL=postgresql://voxel:voxel@127.0.0.1:55432/voxel?schema=public

# 服务端监听地址与端口；Docker 的宿主机映射端口由 SERVER_PORT 控制。
PORT=2567
# HOST=127.0.0.1

# 可选：自定义本地管理网关令牌文件。
# AGENT_GATEWAY_TOKEN_FILE=/absolute/private/path/token

# 可选：使用本机 Whisper CLI。运行 pnpm voice:setup 安装模型。
# 未设置 ASR API 地址且指定 WHISPER_MODEL 或 WHISPER_BIN 时启用。
# 可执行文件可填写绝对路径，或填写 PATH 中的命令名。
# WHISPER_MODEL=/absolute/path/to/ggml-base.bin
# WHISPER_BIN=whisper-cli
# FFMPEG_BIN=ffmpeg

# 3. Docker Compose

# 宿主机映射端口（下列为默认值），容器内部端口由 Compose 固定。
# WEB_PORT=80
# SERVER_PORT=2567
# POSTGRES_PORT=55432
# SPEECH_PORT=8000

# Docker 数据库初始化配置（下列为默认值），部署前设置自己的数据库密码。
# POSTGRES_USER=voxel
# POSTGRES_PASSWORD=voxelpassword
# POSTGRES_DB=voxel
