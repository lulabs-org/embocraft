# Required for world, model-provider and Agent persistence. Start with pnpm db:start,
# then apply schema changes with pnpm db:migrate. Existing .data agent JSON is not imported.
DATABASE_URL=postgresql://voxel:voxel@127.0.0.1:55432/voxel?schema=public
PORT=2567
# Optional server bind address (default: 127.0.0.1).
# HOST=127.0.0.1
# Optional when running the web app on a different local port.
# WEB_ORIGIN=http://127.0.0.1:5173

# Default for SDK clients without a provider; the web UI selects explicitly.
VOICE_PROVIDER=mock
# Optional local AI: install Ollama and pull a LOCAL model, then uncomment.
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional CLI ASR: explicitly set WHISPER_BIN or WHISPER_MODEL without an API URL.
# Install model using pnpm voice:setup. Executables must be on the server PATH.
# WHISPER_MODEL=/absolute/path/to/ggml-base.bin
# WHISPER_BIN=whisper-cli
# FFMPEG_BIN=ffmpeg

# Shared Speaches service: Whisper ASR and Piper TTS.
# SPEECH_API_URL=http://127.0.0.1:8000/v1
# WHISPER_API_URL=  # Optional ASR override
# PIPER_API_URL=    # Optional TTS override

# Initial AI Provider seeds (used only when the database catalog has never been initialized).
# Providers can also be managed directly in the Web Console UI.
# DEEPSEEK_API_KEY=your-key
# DEEPSEEK_MODEL=deepseek-flash

# Standalone CLI AI player process (pnpm agent:ai).
# Managed agents in the Web Console configure their goal, interval, and permissions via the UI.
# SERVER_URL=ws://127.0.0.1:2567
# AGENT_NAME=DeepSeek
# AGENT_GOAL=探索附近环境，用中文介绍观察结果。
# AGENT_MAX_TURNS=100
# AGENT_TOKEN_BUDGET=50000
# AGENT_TASK_TIMEOUT_MS=900000
# AGENT_INTERVAL_MODE=fixed
# AGENT_INTERVAL_MS=3000
# AGENT_INTERVAL_MIN_MS=4000
# AGENT_INTERVAL_MAX_MS=8000
# DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_MAX_TOKENS=512
# DEEPSEEK_TIMEOUT_MS=30000
# AGENT_VOICE_REPLIES=false
# Deprecated: use fine-grained permissions (place/remove/move/chat) instead.
# AGENT_ALLOW_EDITS=false

# Agent control plane: generated at .data/agent-gateway-token when unset.
# Never put the token in VITE_ variables.
# AGENT_GATEWAY_TOKEN=
# AGENT_GATEWAY_TOKEN_FILE=/absolute/private/path/token
# AGENT_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost
