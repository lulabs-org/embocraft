# Shared example for local development and Docker Compose. Copy to .env.
# Model providers, Agent behavior, TTS and ASR settings are managed in the Web Console.
# Standalone CLI players use command-line options (see docs/agent/players.md).

# --- Common deployment settings ---
# Leave unset to use each mode's default:
# local development: http://127.0.0.1:5173; Docker Compose: *.
# Set an explicit frontend origin when deploying with a domain.
# WEB_ORIGIN=http://127.0.0.1:5173

# Shared Speaches service: Whisper ASR and Piper TTS.
# Leave unset for local http://127.0.0.1:8000/v1 or Docker http://speech:8000/v1.
# An explicit override must be reachable from the server's execution environment.
# SPEECH_API_URL=
# WHISPER_API_URL=  # Optional ASR override
# PIPER_API_URL=    # Optional TTS override

# Agent control plane: generated in the server's .data/agent-gateway-token when unset.
# Never put the token in VITE_ variables.
# AGENT_GATEWAY_TOKEN=
# Optional comma-separated frontend origins, including the port when non-default.
# AGENT_GATEWAY_ALLOWED_ORIGINS=https://world.example.com

# --- Local development ---
# Required for world, model-provider, Agent, TTS and ASR persistence.
# Start with pnpm db:start, then apply schema changes with pnpm db:migrate.
# Existing .data provider, Agent, TTS and ASR JSON files are not imported.
# Docker Compose supplies its own DATABASE_URL, HOST and internal PORT.
DATABASE_URL=postgresql://voxel:voxel@127.0.0.1:55432/voxel?schema=public
PORT=2567
# HOST=127.0.0.1
# AGENT_GATEWAY_TOKEN_FILE=/absolute/private/path/token

# Optional CLI ASR: explicitly set WHISPER_BIN or WHISPER_MODEL without an API URL.
# Install model using pnpm voice:setup. Executables must be on the server PATH.
# WHISPER_MODEL=/absolute/path/to/ggml-base.bin
# WHISPER_BIN=whisper-cli
# FFMPEG_BIN=ffmpeg

# --- Docker Compose ---
# Optional host port overrides (defaults shown); container ports stay unchanged.
# WEB_PORT=80
# SERVER_PORT=2567
# POSTGRES_PORT=55432
# SPEECH_PORT=8000
# Database initialization settings; Compose builds the server's internal DATABASE_URL.
# Set a private password before deployment. These values apply only to Docker.
# POSTGRES_USER=voxel
# POSTGRES_PASSWORD=voxelpassword
# POSTGRES_DB=voxel
