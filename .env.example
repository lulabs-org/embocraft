# 本地开发与 Docker Compose 共用的部署配置示例。
# 首次使用时复制为 .env；已有 .env 按需补充。注释项表示可选覆盖。
# 模型服务、托管 Agent、TTS 和 ASR 参数在 Web 控制台配置。
# 独立 AI 玩家使用命令行参数，详见 docs/agent/players.md。

# ==========================================
# 1. 基础服务配置 (Server & Web)
# ==========================================
# - SERVER_PORT / SERVER_HOST：服务端监听端口与地址（Docker 宿主机亦映射此端口）
# - WEB_PORT：前端 Web 端口（Docker 宿主机默认映射 80 端口）
# - WEB_ORIGIN：普通前端业务接口允许的跨域来源（控制世界列表、语音聊天等常规接口）
#   - 格式：仅支持单个 HTTP(S) Origin 或通配符 *
#   - 默认值：本地开发默认 http://127.0.0.1:5173，Docker 默认 *
#   - 生产/域名部署建议填写明确来源，例如 https://world.example.com

SERVER_PORT=2567
SERVER_HOST=127.0.0.1
WEB_PORT=80
WEB_ORIGIN=http://127.0.0.1:5173

# ==========================================
# 2. 数据库配置 (Database)
# ==========================================
# - DATABASE_URL：本地开发使用，直接配置完整的 PostgreSQL 连接串
# - POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT：Docker 部署使用，初始化数据库凭据（容器内会自动组装内部连接串）

DATABASE_URL=postgresql://voxel:voxel@127.0.0.1:55432/voxel?schema=public
POSTGRES_USER=voxel
POSTGRES_PASSWORD=voxelpassword
POSTGRES_DB=voxel
POSTGRES_PORT=55432

# ==========================================
# 3. 敏感数据与凭证加密 (Data Encryption)
# ==========================================
# - DATA_ENCRYPTION_KEY：数据库中敏感凭据（如 LLM/TTS/ASR 的 API Key）的 AES-256-GCM 加密密钥（可选，生产环境建议配置）
#   - 格式：建议使用 32 字节高强度随机字符串（可运行 openssl rand -base64 32 生成）
#   - 默认值：未配置时，API Key 在数据库中以明文存储（适合本地快速开发）；配置后新增或修改的凭据将自动使用 AES-256-GCM 密文存储

DATA_ENCRYPTION_KEY=8PgPhxot8Rl4BJ6FBcO7+p/MzGqFGqXjJ5fGnTQ1HUE=

# ==========================================
# 4. 管理网关配置 (Agent Gateway)
# ==========================================
# - AGENT_GATEWAY_TOKEN：管理网关令牌（24–4096 位无空白字符）
#   - 未设置时在服务端 .data/agent-gateway-token 自动生成
#   - 可运行以下命令快速生成：openssl rand -base64 32
# - AGENT_GATEWAY_ALLOWED_ORIGINS：管理控制台（Agent Gateway）高权限接口允许的跨域来源白名单（控制模型配置、Agent 管理等敏感接口）
#   - 格式：支持多个明确的 HTTP(S) Origin（用英文逗号分隔，非 80/443 默认端口需显式带上端口），严禁使用 *
#   - 默认值：本地开发默认跟随 WEB_ORIGIN（若 WEB_ORIGIN 为 * 则回退至本地 localhost/127.0.0.1 白名单）；Docker 默认 http://localhost,http://127.0.0.1
#   - 使用域名、局域网 IP 或自定义 WEB_PORT 访问管理控制台时，必须将对应访问来源加入此白名单
# - AGENT_GATEWAY_TOKEN_FILE：自定义本地管理网关令牌文件路径（可选，默认 .data/agent-gateway-token）

AGENT_GATEWAY_TOKEN=amlxzdtYU+RKHN+XHTJqXCTpkWMzK2ycZlKjKkO6kKQ=
AGENT_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:5173
AGENT_GATEWAY_TOKEN_FILE=

# ==========================================
# 5. 语音与音频服务 (Speech & Audio)
# ==========================================
# - SPEECH_API_URL：语音服务地址（本地默认 http://127.0.0.1:8000/v1，Docker 默认 http://speech:8000/v1，覆盖地址应能从服务端所在环境访问）

SPEECH_API_URL=http://127.0.0.1:8000/v1
