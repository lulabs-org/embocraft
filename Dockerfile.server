# 后端服务镜像
FROM node:22-bookworm-slim

WORKDIR /app

# SenseVoice 离线识别模型包（目录名，位于构建上下文 models/ 下）。
# 包存在时打进镜像；不存在时跳过构建步骤，运行时回退 Speaches Whisper。
# 换用其他包时用 `pnpm voice:sensevoice <包名>` 准备，再用 --build-arg 覆盖。
ARG SENSE_VOICE_PACK=sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17

# 安装必要的系统库（openssl 供 Prisma，ffmpeg 供 SenseVoice 转非 WAV 音频）
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# 安装 pnpm
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.6.2 --activate

# 复制包管理和 Monorepo 工作区定义
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/agent-runtime/package.json ./packages/agent-runtime/
COPY apps/server/package.json ./apps/server/

# 安装依赖
RUN pnpm install --frozen-lockfile

# 复制源码
COPY packages/shared ./packages/shared
COPY packages/agent-runtime ./packages/agent-runtime
COPY apps/server ./apps/server
COPY docker/server-entrypoint.sh ./docker/server-entrypoint.sh
RUN chmod +x ./docker/server-entrypoint.sh

# 生成 Prisma 客户端
RUN pnpm db:generate

# SenseVoice 模型直接打进镜像，运行时不再依赖宿主机 models/ 挂载。
# 先复制到临时目录再条件复制：模型包可以不存在（纯克隆也能构建），
# 存在时放在源码之后拷贝，改动代码时不会重复拷贝约 230 MB 的模型层。
COPY models/ /tmp/models-src/
RUN set -e; \
    mkdir -p /app/models; \
    src="/tmp/models-src/${SENSE_VOICE_PACK}"; \
    if [ ! -d "$src" ]; then \
      echo "未找到 models/${SENSE_VOICE_PACK}，跳过 SenseVoice 打包；运行时将回退 Speaches Whisper。"; \
      echo "需要离线识别时，先在宿主机运行 pnpm voice:sensevoice 再重建镜像。"; \
    elif [ ! -s "$src/tokens.txt" ] || { [ ! -s "$src/model.int8.onnx" ] && [ ! -s "$src/model.onnx" ]; }; then \
      echo "models/${SENSE_VOICE_PACK} 缺少 tokens.txt 或 model*.onnx，构建中止。" >&2; \
      exit 1; \
    else \
      cp -a "$src" "/app/models/${SENSE_VOICE_PACK}"; \
      echo "已将 SenseVoice 模型打包进镜像：${SENSE_VOICE_PACK}"; \
    fi; \
    rm -rf /tmp/models-src

# 环境变量默认配置
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=2567
ENV VOICE_PROVIDER=mock
ENV ASR_MODEL_DIR=/app/models
ENV SENSE_VOICE_MODEL=${SENSE_VOICE_PACK}

EXPOSE 2567

ENTRYPOINT ["./docker/server-entrypoint.sh"]
CMD ["pnpm", "--filter", "@voxel/server", "start"]
